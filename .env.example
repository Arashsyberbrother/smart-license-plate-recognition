# Application
APP_NAME=Smart License Plate Recognition
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=sqlite:///./data/license_plates.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# API Security (optional)
API_KEY=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Model
MODEL_PATH=models/
CONFIDENCE_THRESHOLD=0.85
